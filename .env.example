# --- Email notifications (enquiries from the contact form) ---
# Recipient for contact-form messages:
ENQUIRY_EMAIL="janakenglishboardingschool@gmail.com"
# SMTP provider (e.g. Gmail requires an App Password, not your normal password):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="youraddress@gmail.com"
